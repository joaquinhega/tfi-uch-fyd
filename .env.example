# Copiar a .env y completar. Nunca subir .env al repo.

# --- Gateway (único puerto publicado) ---
GATEWAY_PORT=8080
IP_BLOCKLIST=
CB_FAIL_MAX=3
CB_RESET_TIMEOUT_SECONDS=15

# --- Token (RS256; ADR-04: vigencia larga, sin refresh) ---
# Las claves se generan con: node scripts/generar-claves.mjs
JWT_EXPIRES_IN=8h
JWT_ISSUER=uch-fyd-auth

# --- Autenticación (MongoDB) ---
MONGO_USER=cambiar
MONGO_PASSWORD=cambiar
MONGO_DB=auth_db

# --- Usuarios de prueba (se cargan al iniciar Autenticación) ---
SEED_ADMIN_EMAIL=admin@uchfyd.com
SEED_ADMIN_PASSWORD=cambiar_min_8
SEED_CLIENTE_EMAIL=cliente@uchfyd.com
SEED_CLIENTE_PASSWORD=cambiar_min_8
SEED_INACTIVO_EMAIL=inactivo@uchfyd.com
SEED_INACTIVO_PASSWORD=cambiar_min_8

# --- Stock (PostgreSQL propia) ---
STOCK_DB_USER=cambiar
STOCK_DB_PASSWORD=cambiar
STOCK_DB_NAME=stock_db

# --- Pedidos (PostgreSQL propia) ---
PEDIDOS_DB_USER=cambiar
PEDIDOS_DB_PASSWORD=cambiar
PEDIDOS_DB_NAME=pedidos_db

# --- Modo degradado y compensación ---
RESERVA_TIMEOUT_SECONDS=2
FAULT_AFTER_RESERVE=false# Copiar a .env y completar. Nunca subir .env al repo.

